# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/tower-of-grace

# ---- Auth ----
# Use a long random string (at least 32 characters) in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Frontend ----
# FRONTEND_URL is used for payment redirect URLs. FRONTEND_URLS is a comma-separated CORS allow-list.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# ---- First admin account (created on startup if it does not exist) ----
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tower-of-grace

# ---- Payments ----
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set in the Flutterwave dashboard webhook settings.
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Email (optional; order and enquiry notifications) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
